# Dev-only overrides so the browser client calls the Vite proxy instead of the
# upstream gateways directly (avoids CORS). The proxy targets are configured in
# vite.config.ts under `server.proxy`. Put real keys in a local .env file
# (see .env.example) — never commit them.
VITE_OPENCODE_GO_BASE_URL=/zen/go/v1
VITE_CODEX_BASE_URL=/backend-api/codex
