# LLM provider credentials (browser-injected via Vite).

# OpenCode Go subscription — copy your key from https://opencode.ai/auth
# (OpenCode Go -> API key). Keys start with `sk-`.
VITE_OPENCODE_GO_API_KEY=

# Optional override for the OpenCode Go gateway base URL.
# Defaults to https://opencode.ai/zen/go/v1
# In dev the .env.development file points this at the Vite proxy (/zen/go/v1).
#VITE_OPENCODE_GO_BASE_URL=

# Codex / ChatGPT subscription token — the `CHATGPT_API_KEY` value that
# `codex login` ("Sign in with ChatGPT", Plus/Pro/Business/Edu/Enterprise)
# stores in ~/.codex/auth.json. This authenticates against
# https://chatgpt.com/backend-api/codex/responses.
VITE_CODEX_CHATGPT_API_KEY=

# Optional override for the Codex backend base URL.
# Defaults to https://chatgpt.com/backend-api/codex
# In dev the .env.development file points this at the Vite proxy (/backend-api/codex).
#VITE_CODEX_BASE_URL=

# Google AI Gemini — API key from Google AI Studio (https://aistudio.google.com/apikey).
# Works with the Flash models: gemini-3.5-flash, gemini-3.6-flash, gemini-3.7-flash.
VITE_GEMINI_API_KEY=

# Optional override for the Gemini Developer API base URL.
# Defaults to https://generativelanguage.googleapis.com/v1beta
#VITE_GEMINI_BASE_URL=
