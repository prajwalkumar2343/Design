{
  "name": "improved-source",
  "version": "0.1.0",
  "private": true,
  "description": "Self-improving observation loop for the design tool: captures every interaction, detects frustration signals, and continuously adapts the app for its user.",
  "type": "module",
  "scripts": {
    "test": "node --test test/store.test.ts test/detectors.test.ts test/analyze.test.ts test/engine.test.ts",
    "typecheck": "../node_modules/.bin/tsc --noEmit --pretty false",
    "demo:report": "node src/node-cli.ts",
    "seed": "node scripts/seed-and-report.ts",
    "demo": "../node_modules/.bin/vite demo --port 5199",
    "build:report": "node src/node-cli.ts --data ./data --out ./dashboard/report.json"
  },
  "engines": {
    "node": ">=23.6"
  }
}
